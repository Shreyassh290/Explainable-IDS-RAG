# Virtual environment
.venv/

# Byte-compiled / cache files
__pycache__/
*.pyc

# Pytest cache
.pytest_cache/

# Data and model directories (ignore content, keep .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
models/*
!models/.gitkeep
# Trained weights are small (about 0.4 MB) and cannot be regenerated byte for byte by accident: track them
!models/*.pt
!models/feature_names.json
!models/scaler.joblib
!models/temperatures.json
!models/run1_valloss/

# Environment variables and logs
.env
*.log

# KB index artifacts
data/kb/index/

# Demo run logs
artifacts/demo_runs/

scratch/
backup/
artifacts/demo_cache/
